{
  "expo": {
    "name": "Tincadia",
    "slug": "app-tincadia",
    "scheme": "tincadia",
    "version": "1.0.10",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tincadia.app",
      "usesAppleSignIn": true,
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Tincadia necesita acceso a tus contactos para encontrar amigos que ya usan la app y facilitar la comunicación.",
        "NSLocationWhenInUseUsageDescription": "Tincadia necesita tu ubicación para enviar coordenadas precisas en caso de emergencia SOS.",
        "NSFaceIDUsageDescription": "Tincadia usa Face ID para iniciar sesión de forma rápida y segura.",
        "NSSpeechRecognitionUsageDescription": "Tincadia necesita acceso al reconocimiento de voz para convertir tu voz en texto.",
        "UIBackgroundModes": [
          "audio",
          "fetch",
          "remote-notification",
          "voip"
        ],
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para videollamadas y enviar fotos.",
        "NSMicrophoneUsageDescription": "Necesitamos acceso a tu micrófono para llamadas de voz y mensajes de audio.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para enviar imágenes y videos.",
        "NSPhotoLibraryAddUsageDescription": "Necesitamos permiso para guardar imágenes en tu galería."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.tincadia.app",
      "usesCleartextTraffic": true,
      "versionCode": 43,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CALL_PHONE",
        "android.permission.READ_PHONE_STATE",
        "android.permission.READ_PHONE_NUMBERS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "com.google.android.gms.permission.AD_ID",
        "android.permission.BIND_TELECOM_CONNECTION_SERVICE"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "androidMode": "default"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.291627235984-al9qlsj9slos34mh9uca410q89oq7jl5"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "android": {
            "firebaseBomVersion": "32.8.1"
          }
        }
      ],
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keepattributes SourceFile,LineNumberTable"
          },
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBMessaging"
            ]
          }
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tincadia necesita acceso a tu galería para cambiar tu foto de perfil.",
          "cameraPermission": "Tincadia necesita acceso a tu cámara para tomar fotos de perfil."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Necesitamos acceso a tu galería para seleccionar imágenes.",
          "savePhotosPermission": "Necesitamos permiso para guardar imágenes en tu galería."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Necesitamos acceso a tu cámara para escanear códigos QR."
        }
      ],
      [
        "expo-web-browser",
        {}
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Tincadia necesita acceso a tus contactos para encontrar amigos que ya usan la app."
        }
      ],
      "expo-sqlite",
      "./plugins/withModularHeaders",
      "./plugins/withPhoneAccountIcon.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "univalle-gi"
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Tincadia utiliza esta información para evaluar el rendimiento, analizar el uso y proveer de soporte técnico especializado, con el fin de mejorar tu experiencia en la aplicación."
        }
      ],
      "./plugins/withPictureInPicture",
      "@config-plugins/react-native-callkeep",
      "./plugins/withFirebaseManifestFix",
      "./plugins/withTabletSupport",
      "./plugins/withVoipAppDelegate",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Tincadia necesita acceso al micrófono para el dictado por voz en la pizarra.",
          "speechRecognitionPermission": "Tincadia necesita acceso al reconocimiento de voz para convertir tu voz en texto."
        }
      ],
      "./plugins/withProguardRules"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f00a224c-23fe-49ad-8474-e1ab7145df54"
      }
    },
    "owner": "tincadia"
  }
}
